# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Application Server Port (Optional, default is 3000)
# Change this when running multiple PM2 instances on different ports (e.g. 3001, 3002)
PORT=3000

# Microsoft SQL Server Configuration
# For SQL Server Express, set DB_SERVER="localhost\\SQLEXPRESS" or "127.0.0.1\\SQLEXPRESS" or "YOUR-PC-NAME\\SQLEXPRESS"
# If using Windows Authentication / SA Account, enter DB_USER and DB_PASSWORD
# Execute schema_sqlserver.sql in SSMS (SQL Server Management Studio) to create ProcurementDB
DB_SERVER="localhost\\SQLEXPRESS"
DB_USER="sa"
DB_PASSWORD="YourPassword123!"
DB_NAME="ProcurementDB"
DB_PORT="1433"
DB_TRUST_SERVER_CERTIFICATE="true"
